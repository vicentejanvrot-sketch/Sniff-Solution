# Single-developer build: listens on 127.0.0.1 only. No sign-in screen.
PORT=3080
DATA_DIR=.data
# local or supabase. Supabase mode fails closed; it never silently falls back.
STORAGE_MODE=local
SUPABASE_URL=https://qmgvzvdqtpwipkgbpxyo.supabase.co
# Set a server-side secret key from Project Settings > API Keys. Never commit it.
SUPABASE_SECRET_KEY=
WORKSPACE_ID=developer
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
# Configure model IDs available to your API accounts in Settings before running.
# Commercial access is server-controlled. Sniff integration is a future module.
ENABLED_MODULES=marketing
